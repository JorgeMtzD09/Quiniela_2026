rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validPronosticoDoc() {
      return request.resource.data.keys().hasOnly([
          'items',
          'actualizado',
          'compartirPronosticos'
        ])
        && request.resource.data.keys().hasAll(['items'])
        && request.resource.data.items is map
        && (
          !request.resource.data.keys().hasAny(['compartirPronosticos']) ||
          request.resource.data.compartirPronosticos is bool
        );
    }

    // Partidos: lectura pública. Cualquier sesión autenticada puede actualizar,
    // pero solo los campos de marcador (golesLocal/golesVisitante). El control de
    // quién es admin se hace en la app (campo admin en usuarios).
    //
    // Para correr scripts/feed-finales.html una sola vez, cambia temporalmente este bloque:
    //   allow update: if request.auth != null ...;
    //   allow create, delete: if false;
    // por:
    //   allow write: if request.auth != null;
    // Después de cargar partidos/73..104, vuelve a dejar create en false.
    match /partidos/{id} {
      allow read: if true;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'golesLocal',
               'golesVisitante',
               'faseEnVivo',
               'estado',
               'minuto',
               'providerStatus',
               'apiFootballFixtureId',
               'lastLiveSync',
               'ganador',
               'definicion',
               'defL',
               'defV',
               'fecha'
             ])
        && (
          !request.resource.data.keys().hasAny(['estado']) ||
          request.resource.data.estado in ['pendiente', 'jugando', 'medio_tiempo', 'finalizado']
        )
        && (
          !request.resource.data.keys().hasAny(['definicion']) ||
          request.resource.data.definicion == null ||
          request.resource.data.definicion in ['te', 'penales']
        )
        && (
          !request.resource.data.keys().hasAny(['ganador']) ||
          request.resource.data.ganador == null ||
          request.resource.data.ganador is string
        )
        && (
          !request.resource.data.keys().hasAny(['defL']) ||
          request.resource.data.defL == null ||
          request.resource.data.defL is number
        )
        && (
          !request.resource.data.keys().hasAny(['defV']) ||
          request.resource.data.defV == null ||
          request.resource.data.defV is number
        )
        && (
          !request.resource.data.keys().hasAny(['fecha']) ||
          request.resource.data.fecha is timestamp
        );
      allow create, delete: if false;
    }

    // Participantes: solo lectura pública
    match /participantes/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Usuarios: lectura individual para login (no se puede listar todos)
    match /usuarios/{usuario} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Pronósticos: lectura pública. Escritura por partido (uno por uno):
    // se pueden AGREGAR pronósticos nuevos, pero los ya guardados no se pueden
    // modificar ni borrar desde el cliente (solo el admin, en la consola).
    match /pronosticos/{clave} {
      allow read: if true;
      allow create: if request.auth != null
        && validPronosticoDoc();
      allow update: if request.auth != null
        && validPronosticoDoc()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['items', 'actualizado', 'compartirPronosticos']);
      allow delete: if false;
    }

    // Reglas para el Reto de Puntos Extra
    match /extras/{documentId} {
      allow read: if true;
      allow write: if request.auth != null
        && (
          documentId == 'resultados' ||
          request.time < get(/databases/$(database)/documents/partidos/103).data.fecha
        );
    }
  }
}
